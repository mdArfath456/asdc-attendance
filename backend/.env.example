NODE_ENV=development
PORT=5000
# Any MongoDB works: local (mongodb://127.0.0.1:27017/asdc) or Atlas (mongodb+srv://...). No replica set needed.
MONGO_URI=mongodb://127.0.0.1:27017/asdc
ADMIN_EMAIL=mdarfathahmed4@gmail.com
# Optional local admin login. If unset, the admin uses Google sign-in only.
ADMIN_PASSWORD=set-a-strong-password-here
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-0000
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SAMESITE=lax
QR_SIGNING_SECRET=change-me-qr-secret-change-me-qr-secret-0000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
BCRYPT_COST=12
TRUST_PROXY=0
TIMEZONE=Asia/Kolkata
# Attendance defaults (confirmed Phase 1 defaults)
SESSION_DURATION_MINUTES=90
QR_REFRESH_SECONDS=20
QR_GRACE_SECONDS=10
LATE_THRESHOLD_MINUTES=10
LATE_WEIGHT=0.5
EXCUSED_POLICY=EXCLUDE
ATTENDANCE_THRESHOLD=75
AUTO_CLOSE_INTERVAL_SECONDS=30
