            "description": "Email + password login; sets httpOnly refresh cookie\nRoles: public"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.data && j.data.accessToken) pm.collectionVariables.set(\"accessToken\", j.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/google",
