{
  "name": "asdc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ASDC Attendance Management System - API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reset-db": "node scripts/reset-database.js",
    "merge-same-day-sessions": "node scripts/merge-same-day-sessions.js",
    "docs:generate": "node scripts/generate-docs.js",
    "test": "jest --runInBand --forceExit",
    "test:replset": "TEST_REPLSET=1 jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js"
  }
}
